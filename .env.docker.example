# Secrets Docker Compose — copier vers .env (racine) et NE JAMAIS committer.
# Générer : openssl rand -base64 32

# Superuser Postgres (migrations / init uniquement)
POSTGRES_USER=kizumai
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_SUPERUSER
POSTGRES_DB=kizumai

# Compte applicatif (privilèges minimaux)
POSTGRES_APP_USER=kizumai_app
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Backend (service api si utilisé)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# CORS_ORIGIN=https://votre-domaine.com
# DATABASE_URL=postgresql://kizumai_app:CHANGE_ME_APP_PASSWORD@postgres:5432/kizumai
# REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
