# Développement local — copier vers .env.development
NODE_ENV=development
PORT=3001

# URL du frontend (CORS)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql://myrokai:myrokai@localhost:5432/myrokai

# Secrets JWT (optionnels en dev — des valeurs par défaut sont utilisées avec avertissement)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# ADMIN_EMAIL=admin@myrokai.com
# ADMIN_PASSWORD=Admin123!

