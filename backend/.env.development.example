# Développement local — copier vers .env.development
NODE_ENV=development
PORT=3001

# URL du frontend (CORS)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql://kizumai:kizumai@localhost:5432/kizumai

# Secrets JWT (optionnels en dev — des valeurs par défaut sont utilisées avec avertissement)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# ADMIN_EMAIL=admin@kizumai.com
# ADMIN_PASSWORD=Admin123!

# ── Batterie IA (clés serveur — jamais exposées au frontend) ──
# Le choix actif se fait dans Admin → Paramètres IA

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# OpenRouter — https://openrouter.ai/keys (modèles :free pour les tests)
OPENROUTER_API_KEY=

# Valeurs par défaut au premier démarrage (surchargées via l'admin)
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-2.0-flash

# ── Notifications Web Push (VAPID) ──
# Générer une paire : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kizumai.com

# URL publique du frontend (liens dans emails / notifications)
APP_URL=http://localhost:5173

# ── File d'attente BullMQ (Redis) ──
# Laisser vide pour désactiver la file (les rappels ne seront pas planifiés).
# docker compose up -d redis  →  redis dispo sur localhost:6379
REDIS_URL=redis://localhost:6379
# QUEUE_ENABLED=true
# QUEUE_CONCURRENCY=5

# ── Email (repli quand l'utilisateur n'a pas d'abonnement push, ex. iOS non installé) ──
# SMTP_HOST vide => les emails sont affichés dans la console (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Kizumai <no-reply@kizumai.com>"

SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@kizumai.fr
SMTP_PASSWORD=********
EMAIL_FROM="Kizumai <no-reply@kizumai.fr>"
