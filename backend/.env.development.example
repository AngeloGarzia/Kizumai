# Développement local — copier vers .env.development
# NE JAMAIS y coller de secrets de production.

NODE_ENV=development
PORT=3001

CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# PostgreSQL (docker compose up -d) — mots de passe locaux uniquement
DATABASE_URL=postgresql://kizumai:kizumai@127.0.0.1:5432/kizumai

# Secrets JWT (optionnels en dev — défauts locaux avec avertissement)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=kizumai-api
JWT_AUDIENCE=kizumai-web
# ADMIN_EMAIL=admin@kizumai.com
# ADMIN_PASSWORD=

# ── Batterie IA (clés serveur — jamais exposées au frontend) ──
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-2.0-flash

# ── Notifications Web Push (VAPID) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kizumai.com

# ── Redis local (docker compose) ──
REDIS_URL=redis://:kizumai_dev_redis@127.0.0.1:6379
# QUEUE_ENABLED=true
# QUEUE_CONCURRENCY=5

# ── Email (vide = log console en dev) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Kizumai <no-reply@kizumai.com>"
