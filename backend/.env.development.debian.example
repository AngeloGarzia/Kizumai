# Dev pointant vers le LAN Debian — copier vers .env.development.debian
# NE JAMAIS committer le fichier avec de vraies clés.

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://192.168.1.11
APP_URL=http://192.168.1.11
APP_BASE_PATH=/kizumai
COOKIE_SECURE=false
ALLOW_INSECURE_CORS=true
TRUST_PROXY=1
DATABASE_URL=postgresql://kizumai:kizumai@127.0.0.1:5432/kizumai
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ── Batterie IA ──
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-3.6-flash

AI_RATE_MAX=120
AI_ANON_RATE_MAX=60
AI_SCAN_RATE_MAX=40
AI_REQUEST_TIMEOUT_MS=120000
AI_FRANCE_TIMEOUT_MS=150000

ALLOW_SELF_SERVE_PAID=true

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kizumai.com

REDIS_URL=redis://127.0.0.1:6379

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Kizumai <no-reply@kizumai.fr>"
