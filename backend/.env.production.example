# Production — copier vers .env.production
# NE JAMAIS committer ce fichier avec de vraies valeurs.
# Générer les secrets : openssl rand -base64 48

NODE_ENV=production
PORT=3001

CORS_ORIGIN=https://votre-domaine.com
APP_URL=https://votre-domaine.com

# PostgreSQL — utilisateur applicatif à privilèges minimaux (pas le superuser)
DATABASE_URL=postgresql://kizumai_app:CHANGE_ME_STRONG_PASSWORD@postgres:5432/kizumai
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_POOL_MAX=20

# Secrets JWT (obligatoires, ≥ 32 caractères, distincts, non triviaux)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=kizumai-api
JWT_AUDIENCE=kizumai-web
# JWT_CLOCK_TOLERANCE_SEC=5
BCRYPT_SALT_ROUNDS=12

# ── Batterie IA (clés serveur — jamais exposées au frontend) ──
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-3.6-flash

# ── Notifications Web Push (VAPID) ──
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@votre-domaine.com

# ── Redis (réseau interne uniquement — mot de passe obligatoire en prod) ──
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
# QUEUE_ENABLED=true
# QUEUE_CONCURRENCY=5

# ── Email ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Kizumai <no-reply@votre-domaine.com>"

# Seed admin (uniquement au premier déploiement)
# ADMIN_EMAIL=admin@votre-domaine.com
# ADMIN_PASSWORD=

# Optionnel
# COOKIE_DOMAIN=.votre-domaine.com
# ALLOW_SELF_SERVE_PAID=false
# DOCUMENT_AUTO_SCAN=true
# TRUST_PROXY=1
# ALLOW_ANON_AI=false
