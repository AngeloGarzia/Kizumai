# Production — copier vers .env.production
# NE JAMAIS commiter ce fichier avec de vraies valeurs

NODE_ENV=production
PORT=3001

CORS_ORIGIN=https://votre-domaine.com

# PostgreSQL (obligatoire en production)
DATABASE_URL=postgresql://user:password@host:5432/kizumai

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ── Batterie IA (clés serveur) ──
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-2.0-flash

# ── Notifications Web Push (VAPID) ──
# Générer une paire : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@votre-domaine.com

# URL publique du frontend
APP_URL=https://votre-domaine.com

# ── File d'attente BullMQ (Redis) ──
# Obligatoire pour la planification des rappels du Planner.
REDIS_URL=redis://user:password@host:6379
# QUEUE_ENABLED=true
# QUEUE_CONCURRENCY=5

# ── Email (repli sans abonnement push) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Kizumai <no-reply@votre-domaine.com>"

# Optionnel
# COOKIE_DOMAIN=.votre-domaine.com
# DB_POOL_MAX=20
