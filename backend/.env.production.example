# Production — copier vers .env.production
# NE JAMAIS commiter ce fichier avec de vraies valeurs

NODE_ENV=production
PORT=3001

CORS_ORIGIN=https://votre-domaine.com

# PostgreSQL (obligatoire en production)
DATABASE_URL=postgresql://user:password@host:5432/myrokay

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Optionnel
# COOKIE_DOMAIN=.votre-domaine.com
# DB_POOL_MAX=20
