# Production LAN — copier vers backend/.env.production.lan sur le serveur Debian
# URL publique : http://192.168.1.11/kizumai

NODE_ENV=production
PORT=3001

# Origines autorisées (séparées par des virgules). Inclure CHAQUE URL utilisée dans le navigateur
# (LAN + IP/DNS publique), sinon login/API → 403 « Origine non autorisée ».
# Exemple : CORS_ORIGIN=http://192.168.1.11,http://88.162.77.134
CORS_ORIGIN=http://192.168.1.11
APP_URL=http://192.168.1.11
APP_BASE_PATH=/kizumai

ALLOW_INSECURE_CORS=true
COOKIE_SECURE=false
TRUST_PROXY=1
DB_SSL=false

JWT_ACCESS_SECRET=CHANGE_ME_OPENSSL_RAND_BASE64_48
JWT_REFRESH_SECRET=CHANGE_ME_OPENSSL_RAND_BASE64_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-3.6-flash

ALLOW_SELF_SERVE_PAID=true
# IA publique « Créer son avenir » sans compte (défaut autorisé ; false pour couper)
# ALLOW_ANON_AI=false

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kizumai.com

# Email (SMTP_PASSWORD / EMAIL_FROM — laisser vide = log seul)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Kizumai <no-reply@kizumai.fr>"

# ADMIN_EMAIL=admin@kizumai.fr
# ADMIN_PASSWORD=
