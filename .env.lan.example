# Racine — copier vers .env pour docker compose LAN
# Générer : openssl rand -hex 24  (évite / @ : dans les mots de passe URL)

# URL vue dans le navigateur (LAN ou IP publique / DNS).
# Si tu ouvres via http://88.x.x.x/kizumai, mets la même base ici
# OU laisse l’API en chemin relatif (recommandé) — voir docker-compose.lan.yml
LAN_PUBLIC_URL=http://192.168.1.11
LAN_HTTP_PORT=80

POSTGRES_USER=kizumai
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_SUPERUSER
POSTGRES_DB=kizumai
POSTGRES_APP_USER=kizumai_app
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
