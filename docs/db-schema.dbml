// Schéma de la base de données Kizumai
// Éditable gratuitement sur https://dbdiagram.io (Import > coller ce fichier).
// Source de vérité : backend/src/database/migrations/*.sql

Table users {
  id integer [pk, increment]
  name varchar(255) [not null]
  email varchar(255) [unique, not null]
  password varchar(255) [not null]
  refresh_token_version integer [not null, default: 0]
  role varchar(20) [not null, default: 'user']
  plan varchar(20) [not null, default: 'free', note: 'free | paid']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table projects {
  id integer [pk, increment]
  user_id integer [ref: > users.id, note: 'ON DELETE CASCADE']
  activity_id integer [ref: > activities.id, note: 'ON DELETE SET NULL']
  location_id integer [ref: > locations.id, note: 'ON DELETE SET NULL']
  title varchar(160)
  budget integer
  currency varchar(3) [not null, default: 'EUR']
  legal_form varchar(40)
  status varchar(20) [not null, default: 'draft', note: 'draft | active | paused | launched | archived']
  stage varchar(30) [not null, default: 'idee', note: 'idee | etude_marche | business_plan | financement | immatriculation | lancement']
  description text
  report text
  sections jsonb [not null, default: '[]']
  metadata jsonb [not null, default: '{}']
  source varchar(20) [not null, default: 'manual']
  ai_prompt text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (user_id, status)
    activity_id
    location_id
  }
}

Table activities {
  id integer [pk, increment]
  label varchar(200) [not null, note: 'unique lower(label)']
  sector varchar(80)
  sub_sector varchar(80)
  ape_code varchar(10)
  description text
  keywords jsonb [not null, default: '[]']
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table locations {
  id integer [pk, increment]
  label varchar(200) [not null, note: 'unique lower(label)']
  address_line1 varchar(255)
  address_line2 varchar(255)
  postal_code varchar(16)
  city varchar(120)
  region varchar(120)
  department varchar(120)
  country varchar(2) [not null, default: 'FR']
  latitude "numeric(9,6)"
  longitude "numeric(9,6)"
  geo_place_id varchar(120)
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table documents {
  id integer [pk, increment]
  project_id integer [not null, ref: > projects.id, note: 'ON DELETE CASCADE']
  uploaded_by integer [ref: > users.id, note: 'ON DELETE SET NULL']
  type varchar(40) [not null, default: 'other', note: 'STI: pdf | image | spreadsheet | document | other (non contraint)']
  title varchar(200)
  file_name varchar(255) [not null]
  storage_key text [not null]
  mime_type varchar(150)
  size_bytes bigint
  attributes jsonb [not null, default: '{}']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    project_id
    type
  }
}

Table companies {
  id integer [pk, increment]
  project_id integer [not null, ref: > projects.id, note: 'ON DELETE CASCADE, 1 société / projet (unique)']
  activity_id integer [ref: > activities.id, note: 'ON DELETE SET NULL']
  location_id integer [ref: > locations.id, note: 'siège, ON DELETE SET NULL']
  denomination varchar(255)
  trade_name varchar(255)
  acronym varchar(60)
  previous_names jsonb [not null, default: '[]']
  logo_url text
  legal_form_code varchar(10)
  legal_form_label varchar(120)
  legal_status varchar(30) [not null, default: 'active', note: 'active | dormant | dissoute | radiee | liquidation']
  is_headquarters boolean [not null, default: true]
  country_code varchar(2) [not null, default: 'FR']
  siren varchar(9) [note: 'unique si non-null']
  siret_hq varchar(14) [note: 'unique si non-null']
  naf_ape_code varchar(6)
  rcs_number varchar(40)
  rcs_city varchar(120)
  vat_number varchar(30) [note: 'unique si non-null']
  eu_id varchar(40)
  lei varchar(20) [note: 'unique si non-null']
  duns varchar(9)
  foreign_reg_number varchar(60)
  foreign_reg_authority varchar(120)
  tax_id varchar(60)
  activity_description text
  share_capital "numeric(18,2)"
  capital_currency varchar(3) [default: 'EUR']
  revenue_last "numeric(18,2)"
  net_income_last "numeric(18,2)"
  fiscal_year_end varchar(5)
  headcount integer
  headcount_range varchar(30)
  incorporation_date date
  activity_start_date date
  cessation_date date
  is_registered boolean [not null, default: false]
  lifecycle_state varchar(20) [not null, default: 'projet', note: 'projet | en_creation | immatriculee | active | suspendue | cessee']
  registration_progress jsonb [not null, default: '{}']
  email varchar(255)
  phone varchar(40)
  website varchar(255)
  social_links jsonb [not null, default: '{}']
  source varchar(30) [not null, default: 'project']
  external_data jsonb [not null, default: '{}']
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    activity_id
    location_id
    country_code
  }
}

Table company_establishments {
  id integer [pk, increment]
  company_id integer [not null, ref: > companies.id, note: 'ON DELETE CASCADE']
  location_id integer [ref: > locations.id, note: 'ON DELETE SET NULL']
  siret varchar(14) [note: 'unique si non-null']
  label varchar(200)
  is_headquarters boolean [not null, default: false]
  is_active boolean [not null, default: true]
  headcount integer
  naf_ape_code varchar(6)
  opened_at date
  closed_at date
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table company_officers {
  id integer [pk, increment]
  company_id integer [not null, ref: > companies.id, note: 'ON DELETE CASCADE']
  role varchar(60) [not null, default: 'dirigeant']
  is_beneficial_owner boolean [not null, default: false]
  person_type varchar(20) [not null, default: 'physique', note: 'physique | morale']
  person_name varchar(255) [not null]
  birth_date date
  nationality varchar(60)
  ownership_percent "numeric(5,2)" [note: '0..100']
  linked_company_id integer [ref: > companies.id, note: 'ON DELETE SET NULL (personne morale)']
  mandate_start date
  mandate_end date
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table company_financials {
  id integer [pk, increment]
  company_id integer [not null, ref: > companies.id, note: 'ON DELETE CASCADE']
  fiscal_year integer [not null, note: 'unique par (company_id, fiscal_year)']
  period_start date
  period_end date
  currency varchar(3) [not null, default: 'EUR']
  revenue "numeric(18,2)"
  net_income "numeric(18,2)"
  gross_operating_surplus "numeric(18,2)"
  total_assets "numeric(18,2)"
  equity "numeric(18,2)"
  headcount integer
  is_published boolean [not null, default: false]
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

// Profil comptable : UNIQUEMENT les données comptables/fiscales absentes du
// reste de la base. Le dossier transmis à l'expert-comptable est assemblé par
// jointure (companies + company_officers + company_establishments + documents).
Table accounting_profiles {
  id integer [pk, increment]
  company_id integer [not null, ref: > companies.id, note: 'ON DELETE CASCADE, 1 profil / société (unique)']
  tax_regime varchar(30) [note: 'IS | IR_BIC | IR_BNC | micro']
  is_option boolean
  vat_regime varchar(30) [note: 'franchise | reel_simplifie | reel_normal | none']
  vat_periodicity varchar(20) [note: 'mensuelle | trimestrielle | annuelle']
  accounting_standard varchar(20) [not null, default: 'PCG', note: 'PCG | IFRS | OTHER']
  fiscal_year_start varchar(5) [note: 'MM-DD']
  fiscal_year_end varchar(5) [note: 'MM-DD']
  first_closing_date date
  firm_name varchar(200)
  firm_contact jsonb [not null, default: '{}']
  firm_siren varchar(9)
  mission_start_date date
  mission_letter_signed boolean [not null, default: false]
  bank_accounts jsonb [not null, default: '[]', note: 'iban/bic/banque']
  director_social_regime varchar(30) [note: 'TNS | assimile_salarie']
  collective_agreement varchar(120)
  idcc_code varchar(10)
  social_organizations jsonb [not null, default: '{}', note: 'URSSAF, retraite, prévoyance, mutuelle, OPCO']
  invoicing_software varchar(120)
  transmission_mode varchar(30) [note: 'depot | email | api | papier']
  estimated_annual_revenue "numeric(18,2)"
  estimated_monthly_invoices integer
  status varchar(20) [not null, default: 'brouillon', note: 'brouillon | pret | transmis']
  transmitted_at timestamptz
  notes text
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

// Planner : tâches, échéances, rendez-vous et rappels affichés sur le calendrier
// (vues semaine/mois/année) et déplaçables en drag & drop.
Table planner_events {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  project_id integer [ref: > projects.id, note: 'ON DELETE SET NULL (lien optionnel)']
  kind varchar(20) [not null, default: 'task', note: 'task | deadline | appointment | reminder']
  title varchar(255) [not null]
  description text
  start_at timestamptz [not null]
  end_at timestamptz [note: '>= start_at']
  all_day boolean [not null, default: false]
  status varchar(20) [not null, default: 'todo', note: 'todo | in_progress | done | cancelled']
  location varchar(255)
  color varchar(20)
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    user_id
    (user_id, start_at)
    project_id
  }
}

// Contacts : fiche complète (adresse inline), rattachée à un utilisateur et,
// optionnellement, à un projet principal.
Table contacts {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  project_id integer [ref: > projects.id, note: 'projet principal, ON DELETE SET NULL']
  contact_type varchar(20) [not null, default: 'person', note: 'person | company']
  category varchar(40) [note: 'client | fournisseur | partenaire | administration | notaire | banquier | expert_comptable | autre']
  civility varchar(10)
  first_name varchar(120)
  last_name varchar(120)
  display_name varchar(200)
  job_title varchar(120)
  organization varchar(200)
  siren varchar(9)
  vat_number varchar(30)
  avatar_url text
  email varchar(255)
  phone varchar(40)
  mobile varchar(40)
  website varchar(255)
  emails jsonb [not null, default: '[]']
  phones jsonb [not null, default: '[]']
  social_links jsonb [not null, default: '{}']
  address_line1 varchar(255)
  address_line2 varchar(255)
  postal_code varchar(16)
  city varchar(120)
  region varchar(120)
  country varchar(2) [not null, default: 'FR']
  birthday date
  preferred_channel varchar(20) [note: 'email | phone | mobile']
  tags jsonb [not null, default: '[]']
  notes text
  is_favorite boolean [not null, default: false]
  source varchar(30) [not null, default: 'manual']
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    user_id
    project_id
    email
    category
  }
}

// Liaison POLYMORPHE : 1 contact rattaché à N objets de types variés.
// entity_id n'a pas de FK native (cible variable) ; l'intégrité est assurée
// par des triggers AFTER DELETE sur projects/documents/planner_events/companies.
Table contact_links {
  id integer [pk, increment]
  contact_id integer [not null, ref: > contacts.id, note: 'ON DELETE CASCADE']
  entity_type varchar(30) [not null, note: 'project | document | planner_event | company']
  entity_id integer [not null, note: 'id polymorphe (pas de FK) — purge par trigger']
  role varchar(80) [note: 'rôle du contact sur cet objet (ex. signataire, notaire)']
  note text
  created_at timestamptz [not null]

  indexes {
    contact_id
    (entity_type, entity_id)
    (contact_id, entity_type, entity_id) [unique]
  }
}

Table push_subscriptions {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  endpoint text [unique, not null]
  p256dh text [not null]
  auth text [not null]
  user_agent text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table user_connections {
  id integer [pk, increment]
  user_id integer [ref: > users.id, note: 'ON DELETE SET NULL']
  email varchar(255)
  action varchar(50) [not null]
  ip_address varchar(45)
  user_agent text
  created_at timestamptz [not null]
}

Table ai_prompts {
  id integer [pk, increment]
  prompt_key varchar(100) [unique, not null]
  name varchar(255) [not null]
  role varchar(20) [not null, default: 'system']
  content text [not null]
  updated_at timestamptz [not null]
}

Table app_settings {
  key varchar(100) [pk]
  value text [not null]
  updated_at timestamptz [not null]
}

Table schema_migrations {
  id integer [pk, increment]
  filename varchar(255) [unique, not null]
  applied_at timestamptz [not null]
}
